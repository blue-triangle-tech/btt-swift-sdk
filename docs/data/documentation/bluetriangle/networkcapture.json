{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/NetworkCapture"},"metadata":{"role":"article","modules":[{"name":"BlueTriangle"}],"roleHeading":"Article","title":"Network Capture"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"To enable network capture, first configure the SDK with a non-zero network sample rate:","type":"text"}]},{"type":"codeListing","code":["BlueTriangle.configure { config in","    ...","    config.networkSampleRate = 0.05","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value of "},{"type":"codeVoice","code":"0.05"},{"type":"text","text":", for example, means that network capture will be randomly enabled for 5% of user sessions. Network requests using a "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"NetworkCaptureSessionDelegate"},{"type":"text","text":" or made with one of the "},{"type":"codeVoice","code":"bt"},{"type":"text","text":"-prefixed "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" methods will be associated with the last main timer to have been started at the time a request completes. Note that requests are not associated with a timer until the request ends."}]},{"type":"heading","level":2,"anchor":"NetworkCaptureSessionDelegate","text":"`NetworkCaptureSessionDelegate`"},{"type":"paragraph","inlineContent":[{"text":"You can use ","type":"text"},{"code":"NetworkCaptureSessionDelegate","type":"codeVoice"},{"text":" or a subclass as your ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" delegate to gather information about network requests when network capture is enabled:","type":"text