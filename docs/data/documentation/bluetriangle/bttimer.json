{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer"},"abstract":[{"type":"text","text":"Create timers to measure responses to user interactions."}],"metadata":{"role":"article","modules":[{"name":"BlueTriangle"}],"roleHeading":"Article","title":"Using Timers"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/bluetriangle\/bttimer"]}],"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"To measure the duration of a user interaction, initialize a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/Page"},{"type":"text","text":" object describing that interation and pass it to "},{"code":"BlueTriangle\/BlueTriangle\/startTimer(page:timerType:)","type":"codeVoice"},{"type":"text","text":" to receive a running timer instance."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let page = Page(pageName: \"MY_PAGE\")","let timer = BlueTriangle.startTimer(page: page)"]},{"inlineContent":[{"type":"text","text":"If you need to defer the start of the timer, use "},{"type":"codeVoice","code":"BlueTriangle\/BlueTriangle\/makeTimer(page:timerType:)"},{"type":"text","text":" and call the returned timer’s "},{"type":"codeVoice","code":"start()"},{"type":"text","text":" method when you are ready to start timing:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let page = Page(pageName: \"MY_PAGE\")","let timer = BlueTriangle.makeTimer(page: page)","...","timer.start()"]},{"inlineContent":[{"type":"text","text":"In both cases, pass your timer to "},{"type":"reference","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)","isActive":true},{"type":"text","text":" to send it to the Blue Triangle server."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["BlueTriangle.endTimer(timer)"]},{"inlineContent":[{"text":"Running timers are automatically stopped when passed to ","type":"text"},{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)","type":"reference","isActive":true},{"text":", though you can end timing earlier by calling the timer’s ","type":"text"},{"code":"end()","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["timer.end()","...","\/\/ You must still pass the timer to `BlueTriangle.endTimer(_:)` to send it to the Blue Triangle server","BlueTriangle.endTimer(timer)"]},{"inlineContent":[{"type":"text","text":"For timers that are associated with checkout, create a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/PurchaseConfirmation"},{"type":"text","text":" object to pass along with the timer to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["timer.end()","let purchaseConfirmation = PurchaseConfirmation(cartValue: 99.00)","BlueTriangle.endTimer(timer, purchaseConfirmation: purchaseConfirmation)"]},{"anchor":"Timer-Types","level":3,"text":"Timer Types","type":"heading"},{"inlineContent":[{"code":"BlueTriangle\/BlueTriangle\/makeTimer(page:timerType:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"BlueTriangle\/BlueTriangle\/startTimer(page:timerType:)","type":"codeVoice"},{"text":" have a ","type":"text"},{"code":"timerType","type":"codeVoice"},{"text":" parameter to specify the type of the timer they return. By default, both methods return main timers with the type ","type":"text"},{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/main","isActive":true,"type":"reference"},{"text":". When ","type":"text"},{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/NetworkCapture","isActive":true,"type":"reference"},{"text":" is enabled, requests made with one of the ","type":"text"},{"code":"bt","type":"codeVoice"},{"text":"-prefixed ","type":"text"},{"code":"URLSession","type":"codeVoice"},{"text":" methods will be associated with the last main timer to have been started at the time the request completes. It is recommended to only have a single main timer running at any given time. If you need overlapping timers, create additional custom timers by specifying a ","type":"text"},{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/custom","isActive":true,"type":"reference"},{"text":" timer type:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let mainTimer = BlueTriangle.startTimer(page: Page(pageName: \"MY_PAGE\"))","let customTimer = BlueTriangle.startTimer(page: Page(pageName: \"MY_OTHER_TIMER\"), timerType: .custom)","\/\/ ...","BlueTriangle.endTimer(mainTimer)","\/\/ ...","BlueTriangle.endTimer(customTimer)"]}],"kind":"content"}],"sections":[],"references":{"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/BTTimer/TimerType/main":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"}],"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/main","title":"BTTimer.TimerType.main","url":"\/documentation\/bluetriangle\/bttimer\/timertype\/main","type":"topic","abstract":[{"text":"A timer used to measure primary user interactions and identify captured network requests.","type":"text"}]},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/BTTimer/TimerType/custom":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"custom","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/bluetriangle\/bttimer\/timertype\/custom","title":"BTTimer.TimerType.custom","abstract":[{"type":"text","text":"A timer used to measure additional interactions."}],"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/custom","type":"topic","role":"symbol"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/BlueTriangle/endTimer(_:purchaseConfirmation:)":{"type":"topic","url":"\/documentation\/bluetriangle\/bluetriangle\/endtimer(_:purchaseconfirmation:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"endTimer"},{"kind":"text","text":"("},{"preciseIdentifier":"c:@M@BlueTriangle@objc(cs)BTTimer","kind":"typeIdentifier","text":"BTTimer"},{"kind":"text","text":", "},{"kind":"externalParam","text":"purchaseConfirmation"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@M@BlueTriangle@objc(cs)PurchaseConfirmation","kind":"typeIdentifier","text":"PurchaseConfirmation"},{"text":"?)","kind":"text"}],"abstract":[{"type":"text","text":"Ends a timer and upload it to Blue Triangle for processing."}],"kind":"symbol","role":"symbol","title":"endTimer(_:purchaseConfirmation:)","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/Page":{"role":"symbol","type":"topic","navigatorTitle":[{"text":"Page","kind":"identifier"}],"abstract":[{"text":"An object describing a user interaction.","type":"text"}],"title":"Page","url":"\/documentation\/bluetriangle\/page","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/Page","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Page","kind":"identifier"}]},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/NetworkCapture":{"abstract":[{"type":"text","text":"The Blue Triangle SDK supports capturing network requests using either the "},{"type":"codeVoice","code":"NetworkCaptureSessionDelegate"},{"type":"text","text":" or "},{"type":"codeVoice","code":"bt"},{"type":"text","text":"-prefixed "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" methods."}],"title":"Network Capture","type":"topic","kind":"article","url":"\/documentation\/bluetriangle\/networkcapture","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/NetworkCapture","role":"article"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/PurchaseConfirmation":{"abstract":[{"type":"text","text":"An object describing a purchase confirmation interaction."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PurchaseConfirmation"}],"navigatorTitle":[{"kind":"identifier","text":"PurchaseConfirmation"}],"url":"\/documentation\/bluetriangle\/purchaseconfirmation","type":"topic","title":"PurchaseConfirmation","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/PurchaseConfirmation","role":"symbol"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle":{"kind":"symbol","type":"topic","title":"BlueTriangle","role":"collection","url":"\/documentation\/bluetriangle","abstract":[{"type":"text","text":"Blue Triangle analytics SDK for iOS."}],"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle"}}}