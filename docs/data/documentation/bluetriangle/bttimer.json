{"abstract":[{"text":"Create timers to measure responses to user interactions.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/bluetriangle\/bttimer"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"BlueTriangle"}],"role":"article","title":"Using Timers","roleHeading":"Article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer"},"hierarchy":{"paths":[["doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To measure the duration of a user interaction, initialize a "},{"type":"reference","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/Page","isActive":true},{"type":"text","text":" object describing that interation and pass it to "},{"type":"codeVoice","code":"BlueTriangle\/BlueTriangle\/startTimer(page:timerType:)"},{"type":"text","text":" to receive a running timer instance."}]},{"type":"codeListing","code":["let page = Page(pageName: \"MY_PAGE\")","let timer = BlueTriangle.startTimer(page: page)"],"syntax":"swift"},{"inlineContent":[{"text":"If you need to defer the start of the timer, use ","type":"text"},{"code":"BlueTriangle\/BlueTriangle\/makeTimer(page:timerType:)","type":"codeVoice"},{"text":" and call the returned timer’s ","type":"text"},{"code":"start()","type":"codeVoice"},{"text":" method when you are ready to start timing:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let page = Page(pageName: \"MY_PAGE\")","let timer = BlueTriangle.makeTimer(page: page)","...","timer.start()"],"syntax":"swift"},{"inlineContent":[{"text":"In both cases, pass your timer to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)","type":"reference"},{"text":" to send it to the Blue Triangle server.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["BlueTriangle.endTimer(timer)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Running timers are automatically stopped when passed to "},{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)","type":"reference","isActive":true},{"type":"text","text":", though you can end timing earlier by calling the timer’s "},{"type":"codeVoice","code":"end()"},{"type":"text","text":" method."}],"type":"paragraph"},{"type":"codeListing","code":["timer.end()","...","\/\/ You must still pass the timer to `BlueTriangle.endTimer(_:)` to send it to the Blue Triangle server","BlueTriangle.endTimer(timer)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"For timers that are associated with checkout, create a "},{"isActive":true,"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/PurchaseConfirmation","type":"reference"},{"type":"text","text":" object to pass along with the timer to "},{"isActive":true,"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["timer.end()","let purchaseConfirmation = PurchaseConfirmation(cartValue: 99.00)","BlueTriangle.endTimer(timer, purchaseConfirmation: purchaseConfirmation)"],"syntax":"swift"},{"anchor":"Timer-Types","level":3,"type":"heading","text":"Timer Types"},{"inlineContent":[{"type":"codeVoice","code":"BlueTriangle\/BlueTriangle\/makeTimer(page:timerType:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"BlueTriangle\/BlueTriangle\/startTimer(page:timerType:)"},{"type":"text","text":" have a "},{"type":"codeVoice","code":"timerType"},{"type":"text","text":" parameter to specify the type of the timer they return. By default, both methods return main timers with the type "},{"isActive":true,"type":"reference","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/main"},{"type":"text","text":". When "},{"isActive":true,"type":"reference","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/NetworkCapture"},{"type":"text","text":" is enabled, requests made with one of the "},{"type":"codeVoice","code":"bt"},{"type":"text","text":"-prefixed "},{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" methods will be associated with the last main timer to have been started at the time the request completes. It is recommended to only have a single main timer running at any given time. If you need overlapping timers, create additional custom timers by specifying a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/custom"},{"type":"text","text":" timer type:"}],"type":"paragraph"},{"type":"codeListing","code":["let mainTimer = BlueTriangle.startTimer(page: Page(pageName: \"MY_PAGE\"))","let customTimer = BlueTriangle.startTimer(page: Page(pageName: \"MY_OTHER_TIMER\"), timerType: .custom)","\/\/ ...","BlueTriangle.endTimer(mainTimer)","\/\/ ...","BlueTriangle.endTimer(customTimer)"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/Page":{"navigatorTitle":[{"text":"Page","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"An object describing a user interaction."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Page","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/bluetriangle\/page","title":"Page","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/Page"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/BTTimer/TimerType/custom":{"title":"BTTimer.TimerType.custom","abstract":[{"type":"text","text":"A timer used to measure additional interactions."}],"type":"topic","url":"\/documentation\/bluetriangle\/bttimer\/timertype\/custom","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"custom","kind":"identifier"}],"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/custom","role":"symbol","kind":"symbol"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle":{"abstract":[{"text":"Blue Triangle analytics SDK for iOS.","type":"text"}],"kind":"symbol","url":"\/documentation\/bluetriangle","type":"topic","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle","title":"BlueTriangle","role":"collection"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/BTTimer/TimerType/main":{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BTTimer\/TimerType\/main","url":"\/documentation\/bluetriangle\/bttimer\/timertype\/main","kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"main"}],"title":"BTTimer.TimerType.main","abstract":[{"type":"text","text":"A timer used to measure primary user interactions and identify captured network requests."}],"type":"topic","role":"symbol"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/BlueTriangle/endTimer(_:purchaseConfirmation:)":{"identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/BlueTriangle\/endTimer(_:purchaseConfirmation:)","type":"topic","abstract":[{"type":"text","text":"Ends a timer and upload it to Blue Triangle for processing."}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"endTimer"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"BTTimer","preciseIdentifier":"c:@M@BlueTriangle@objc(cs)BTTimer"},{"kind":"text","text":", "},{"kind":"externalParam","text":"purchaseConfirmation"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PurchaseConfirmation","preciseIdentifier":"c:@M@BlueTriangle@objc(cs)PurchaseConfirmation"},{"kind":"text","text":"?)"}],"url":"\/documentation\/bluetriangle\/bluetriangle\/endtimer(_:purchaseconfirmation:)","title":"endTimer(_:purchaseConfirmation:)"},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/PurchaseConfirmation":{"type":"topic","kind":"symbol","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/PurchaseConfirmation","title":"PurchaseConfirmation","role":"symbol","navigatorTitle":[{"text":"PurchaseConfirmation","kind":"identifier"}],"url":"\/documentation\/bluetriangle\/purchaseconfirmation","abstract":[{"text":"An object describing a purchase confirmation interaction.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PurchaseConfirmation","kind":"identifier"}]},"doc://btt-swift-sdk.BlueTriangle/documentation/BlueTriangle/NetworkCapture":{"title":"Network Capture","abstract":[{"type":"text","text":"The Blue Triangle SDK supports capturing network requests using either the "},{"code":"NetworkCaptureSessionDelegate","type":"codeVoice"},{"type":"text","text":" or "},{"code":"bt","type":"codeVoice"},{"type":"text","text":"-prefixed "},{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" methods."}],"url":"\/documentation\/bluetriangle\/networkcapture","type":"topic","identifier":"doc:\/\/btt-swift-sdk.BlueTriangle\/documentation\/BlueTriangle\/NetworkCapture","kind":"article","role":"article"}}}